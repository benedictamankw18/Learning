# Ghana SHS LMS - Frontend Environment Variables
# Copy this file to .env and fill in actual values.
# Then run:  node scripts/generate-env.js
# to regenerate assets/js/env.js from this file.

# ─── Environment ─────────────────────────────────────────────
# Options: development | staging | production
APP_ENV=development

# ─── API ─────────────────────────────────────────────────────
# The base URL of the lms-api backend (no trailing slash).
# Required: there is no built-in fallback URL.
API_BASE_URL=http://localhost:8000

# ─── Local demo quick-login (development only) ───────────────
# Optional JSON object used by the login page's quick-login buttons.
# Never set this in staging or production.
# DEMO_CREDENTIALS={"super_admin":{"login":"superadmin","password":"..."},"admin":{"login":"admin","password":"..."}}

# ─── Staging example ─────────────────────────────────────────
# APP_ENV=staging
# API_BASE_URL=https://staging-api.ghanalms.edu.gh

# ─── Production example ──────────────────────────────────────
# APP_ENV=production
# API_BASE_URL=https://api.ghanalms.edu.gh
