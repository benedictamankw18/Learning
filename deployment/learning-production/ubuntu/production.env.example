# Copy to /opt/learning/.env.docker and fill in real secrets.
# Used by the MariaDB container (MYSQL_* keys) and for frontend build interpolation.

# --- Values read by the MariaDB image ---------------------------------------
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=lms
MYSQL_USER=lms_user
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD

# --- Keep in sync with lms-api/.env.docker ----------------------------------
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
DB_NAME=lms
DB_USER=lms_user
DB_PASS=REPLACE_WITH_RANDOM_APP_PASSWORD

# API origin as seen by the browser. No /api suffix, no port (proxy is on 80).
API_BASE_URL=http://lms.geslab.local
