# Copy to /opt/learning/lms-api/.env.docker and fill in real secrets.
# NOTE: this application reads DB_NAME / DB_USER / DB_PASS (not DB_DATABASE etc.).

DB_HOST=db
DB_PORT=3306
DB_NAME=lms
DB_USER=lms_user
DB_PASS=REPLACE_WITH_SAME_APP_PASSWORD_AS_ROOT_ENV

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

APP_ENV=production
APP_DEBUG=false
APP_URL=http://lms.geslab.local
FRONTEND_URL=http://lms.geslab.local

# Required: the frontend origin. A .local hostname is NOT auto-detected as a LAN origin.
ALLOWED_ORIGINS=http://lms.geslab.local

# Default: MailHog (kept in the production Compose file because the school has
# no internet). Captured mail is visible at http://192.168.10.196:8025
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@lms.geslab.local
MAIL_FROM_NAME="LMS System"
MAIL_ENCRYPTION=

# To switch to a real SMTP provider later, replace the MAIL_* lines above,
# for example (port 587 uses STARTTLS; use 465 with MAIL_ENCRYPTION=ssl):
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your-account
# MAIL_PASSWORD=your-password
# Then: cd /opt/learning && docker compose up -d --force-recreate api
# MailHog can stay running; it simply will not receive mail.

STORAGE_TYPE=local
STORAGE_PATH=../uploads
MAX_UPLOAD_SIZE=104857600

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

REPORT_SCHEDULER_AUTO_TRIGGER=true
REPORT_SCHEDULER_TRIGGER_COOLDOWN_SECONDS=120
