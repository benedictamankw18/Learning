DB_HOST=db
DB_PORT=3306
DB_NAME=lms
DB_USER=lms_user
DB_PASS=changeme_pass

JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8082

# Comma-separated allowlist. Required in production; never use * there.
ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="LMS System"

STORAGE_TYPE=local
STORAGE_PATH=../storage/uploads
MAX_UPLOAD_SIZE=10485760

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

REPORT_SCHEDULER_AUTO_TRIGGER=true
REPORT_SCHEDULER_TRIGGER_COOLDOWN_SECONDS=120
