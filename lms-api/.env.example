# ---------------------------------------------------------------------------
# LMS API - local development environment template
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lms
DB_USER=lms_user
DB_PASS=changeme_pass

# Authentication
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC

# CORS: comma-separated list of allowed frontend origins.
# Never use * together with credentials in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mail (use MailHog locally: host "mailhog" in Docker, "localhost" on the host)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="LMS System"

# Storage
STORAGE_TYPE=local
STORAGE_PATH=../storage/uploads
MAX_UPLOAD_SIZE=10485760

# Rate limiting and pagination
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Report scheduler
REPORT_SCHEDULER_AUTO_TRIGGER=true
REPORT_SCHEDULER_TRIGGER_COOLDOWN_SECONDS=120
